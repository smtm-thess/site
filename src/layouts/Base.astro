---
// Το κοινό πλαίσιο κάθε σελίδας: head, κεφαλίδα, μενού, υποσέλιδο.
import '@fontsource/manrope/greek-400.css';
import '@fontsource/manrope/latin-400.css';
import '@fontsource/manrope/greek-500.css';
import '@fontsource/manrope/latin-500.css';
import '@fontsource/manrope/greek-600.css';
import '@fontsource/manrope/latin-600.css';
import '@fontsource/manrope/greek-700.css';
import '@fontsource/manrope/latin-700.css';
import '@fontsource/manrope/greek-800.css';
import '@fontsource/manrope/latin-800.css';
import '@fontsource/fira-sans-extra-condensed/greek-800.css';
import '@fontsource/fira-sans-extra-condensed/latin-800.css';
import '@fontsource/fira-sans-extra-condensed/greek-900.css';
import '@fontsource/fira-sans-extra-condensed/latin-900.css';
import '../styles/global.css';
import { UNION, GOATCOUNTER, NAV } from '../consts';
import { u, abs } from '../lib/url';

interface Props {
  title?: string;          // τίτλος της σελίδας (χωρίς το όνομα του Σωματείου)
  description?: string;
  image?: string;          // εικόνα κοινοποίησης, διαδρομή μέσα στο site
  type?: 'website' | 'article';
  active?: string;         // ποιο στοιχείο του μενού φωτίζεται
  published?: Date;
}
const {
  title,
  description = UNION.description,
  image = '/og/default.png',
  type = 'website',
  active = '',
  published,
} = Astro.props;

const fullTitle = title ? `${title} | ${UNION.short}` : `${UNION.name} | ${UNION.short}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = abs(image, Astro.site);
---
<!doctype html>
<html lang="el">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{fullTitle}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml">
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')}>
  <link rel="alternate" type="application/rss+xml" title={`Ανακοινώσεις ${UNION.short}`} href={u('/rss.xml')}>
  <meta name="theme-color" content="#CC2A1E">
  <meta property="og:site_name" content={UNION.name}>
  <meta property="og:locale" content="el_GR">
  <meta property="og:type" content={type}>
  <meta property="og:title" content={title ?? UNION.name}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonical}>
  <meta property="og:image" content={ogImage}>
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image">
  {published && <meta property="article:published_time" content={published.toISOString()}>}
  {GOATCOUNTER && <script is:inline async data-goatcounter={`https://${GOATCOUNTER}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>}
</head>
<body>
<a class="skip" href="#main">Στο περιεχόμενο</a>

<header class="mast" id="mast" data-open="false">
  <div class="wrap">
    <div class="mast-in">
      <a class="brand" href={u('/')} aria-label={`${UNION.name}, αρχική`}>
        <img class="logo" src={u('/logo.svg')} alt="" width="60" height="60">
        <span class="brand-name">{UNION.lines[0]}<br>{UNION.lines[1]}
          <span class="brand-tag">{UNION.tagline}</span></span>
      </a>
      <button class="menu-btn" id="menu-btn" type="button" aria-expanded="false" aria-controls="main-nav">ΜΕΝΟΥ</button>
      <nav class="nav" id="main-nav" aria-label="Κύριο μενού">
        {NAV.map((n) => (
          <a href={u(n.href)} class={active === n.key ? 'on' : undefined} aria-current={active === n.key ? 'page' : undefined}>{n.label}</a>
        ))}
        <a class:list={['join', { on: active === 'melos' }]} href={u('/melos/')} aria-current={active === 'melos' ? 'page' : undefined}>Γίνε μέλος</a>
      </nav>
    </div>
  </div>
</header>

<main id="main">
  <slot />
</main>

<footer class="foot">
  <div class="wrap">
    <a class="brand" href={u('/')}>
      <img class="logo" src={u('/logo.svg')} alt="" width="50" height="50" loading="lazy">
      <span class="brand-name">{UNION.lines[0]}<br>{UNION.lines[1]}
        <span class="brand-tag">{UNION.place}<br>{UNION.street}</span></span>
    </a>
    <div>
      <h2 class="lab foot-h">ΕΠΙΚΟΙΝΩΝΙΑ</h2>
      <ul>
        <li><a href={`mailto:${UNION.email}`}>{UNION.email}</a></li>
        {UNION.phones.map((p) => <li><a class="tel" href={`tel:+30${p.replace(/\s/g, '')}`}>{p}</a></li>)}
        {UNION.viber && <li><a href={UNION.viber} rel="noopener">Το κανάλι μας στο Viber</a></li>}
      </ul>
    </div>
    <div>
      <h2 class="lab foot-h">ΤΟ ΣΩΜΑΤΕΙΟ</h2>
      <ul>
        <li><a href={u('/poioi-eimaste/')}>Ποιοι είμαστε</a></li>
        <li><a href={u('/katastatiko/')}>Καταστατικό</a></li>
        <li><a href={u('/sse/')}>Κλαδική ΣΣΕ</a></li>
        <li><a href={u('/melos/')}>Γίνε μέλος</a></li>
        <li><a href={u('/grapse/')}>Γράψε μας</a></li>
      </ul>
    </div>
    <div>
      <h2 class="lab foot-h">ΚΕΙΜΕΝΑ</h2>
      <ul>
        <li><a href={u('/anakoinoseis/')}>Ανακοινώσεις</a></li>
        <li><a href={UNION.oldSite} rel="noopener">Παλιό site, 2012–2025</a></li>
        <li><a href={u('/rss.xml')}>RSS</a></li>
        <li><a href={u('/dedomena/')}>Προσωπικά δεδομένα</a></li>
      </ul>
    </div>
    <p class="foot-note"><span>Χωρίς cookies. Μετράμε μόνο ανώνυμα τις επισκέψεις.</span><span>Εμείς παράγουμε τον πλούτο!</span></p>
  </div>
</footer>

<p class="toast" id="toast" role="status" aria-live="polite" hidden></p>

<script>
  // Μενού στο κινητό
  const mast = document.getElementById('mast')!;
  const btn = document.getElementById('menu-btn')!;
  btn.addEventListener('click', () => {
    const open = mast.getAttribute('data-open') !== 'true';
    mast.setAttribute('data-open', String(open));
    btn.setAttribute('aria-expanded', String(open));
  });

  // Μικρό μήνυμα στο κάτω μέρος της οθόνης
  const toast = document.getElementById('toast')!;
  let tt: ReturnType<typeof setTimeout>;
  (window as any).smtmSay = (msg: string) => {
    toast.textContent = msg;
    toast.hidden = false;
    clearTimeout(tt);
    tt = setTimeout(() => (toast.hidden = true), 3200);
  };

  // Κουμπιά αντιγραφής: data-copy="κείμενο"
  document.addEventListener('click', (e) => {
    const b = (e.target as Element).closest<HTMLElement>('[data-copy]');
    if (!b) return;
    const text = b.dataset.copy!;
    const done = () => (window as any).smtmSay(b.dataset.copied || 'Αντιγράφηκε');
    navigator.clipboard?.writeText(text).then(done, () => (window as any).smtmSay(text)) ?? (window as any).smtmSay(text);
  });

  // Μέτρηση (GoatCounter): πόσοι κατεβάζουν PDF ή βίντεο και πόσοι βλέπουν το βίντεο.
  // Μόνο σύνολα, κανένα στοιχείο για το ποιος.
  const gc = (path: string, title: string) => {
    try { (window as any).goatcounter?.count?.({ path, title, event: true }); } catch {}
  };
  document.addEventListener('click', (e) => {
    const a = (e.target as Element).closest<HTMLAnchorElement>('a[download]');
    if (a) gc(`κατέβασμα: ${new URL(a.href).pathname}`, a.textContent?.trim() || 'Κατέβασμα');
  });
  document.querySelectorAll<HTMLVideoElement>('video').forEach((v) => {
    v.addEventListener('play', () => gc(`βίντεο: ${v.currentSrc ? new URL(v.currentSrc).pathname : location.pathname}`, 'Είδε το βίντεο'), { once: true });
  });

  // Ο αριθμός «χρόνια χωρίς Σύμβαση» μετράει προς τα πάνω όταν φτάνεις εκεί (όχι αν
  // έχεις κλείσει τις κινήσεις στη συσκευή σου, και όχι αν φαίνεται ήδη με το άνοιγμα)
  try {
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
      document.querySelectorAll<HTMLElement>('[data-countup]').forEach((el) => {
        const n = Number(el.dataset.countup);
        if (!n || el.getBoundingClientRect().top < innerHeight) return;
        el.style.minWidth = `${el.offsetWidth}px`;
        el.textContent = '0';
        const io = new IntersectionObserver((es) => {
          if (!es.some((e) => e.isIntersecting)) return;
          io.disconnect();
          const t0 = performance.now();
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / 900);
            el.textContent = String(Math.round(n * (1 - Math.pow(1 - p, 3))));
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        }, { threshold: 0.6 });
        io.observe(el);
      });
    }
  } catch {}

  // Αντίστροφη μέτρηση ως μια μέρα (data-count="ΕΕΕΕ-ΜΜ-ΗΗ"), με την ώρα της Θεσσαλονίκης
  try {
    const today = new Date(new Date().toLocaleDateString('en-CA', { timeZone: 'Europe/Athens' }) + 'T00:00:00Z');
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const d = Math.round((new Date(el.dataset.count + 'T00:00:00Z').getTime() - today.getTime()) / 86400000);
      if (d > 1) el.textContent = `σε ${d} μέρες`;
      else if (d === 1) el.textContent = 'αύριο';
      else if (d === 0) el.textContent = 'σήμερα';
      else el.hidden = true;
    });
  } catch {}
</script>
</body>
</html>
