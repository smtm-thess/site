---
// Η κορυφή της αρχικής. Τι δείχνει και πότε: src/lib/hero.ts
// (ο αγώνας της στιγμής, το νεότερο κείμενο ή το μόνιμο μπλοκ της Σύμβασης).
import { Picture } from 'astro:assets';
import { agonas } from '../data/agonas';
import { longDate } from '../lib/dates';
import { u } from '../lib/url';
import { allTexts, textHref } from '../lib/texts';
import type { Hero } from '../lib/hero';
import { WAGES, YEARS_WITHOUT_SSE } from '../consts';

interface Props { h: Hero }
const { h } = Astro.props;
const call = (await allTexts()).find((t) => t.id === agonas.text);
const t = h.mode === 'text' ? h.text : undefined;
const photo = t?.data.photos[t.data.homePhoto] ?? t?.data.photos[0];
---
{h.mode === 'agonas' ? (
  <section class="strike" aria-labelledby="strike-title">
    <div class="wrap">
      <div class="strike-top">
        <p class="kicker">{agonas.kicker}</p>
        <p class="count" data-count={agonas.countTo}></p>
      </div>
      <h1 class="mega" id="strike-title" aria-label={agonas.title}>{[...agonas.title].map((ch, i) => <span class="ltr" aria-hidden="true" style={`--i:${i}`}><span>{ch}</span></span>)}</h1>
      <p class="date-line">{agonas.dateLine}</p>
      <div class="facts">
        {agonas.facts.map((f) => <div><span class="lab">{f.label}</span><p>{f.text}</p></div>)}
      </div>
      {call && (
        <div class="btn-row">
          <a class="btn btn-paper" href={textHref(call)}>Διάβασε την ανακοίνωση</a>
          {call.data.video && <a class="btn btn-line" href={`${textHref(call)}#video`}>Το βίντεο</a>}
          {call.data.pdf && <a class="btn btn-line" href={u(call.data.pdf)} download>PDF για μοίρασμα</a>}
        </div>
      )}
    </div>
  </section>
) : t && photo ? (
  <section class="photo-hero" aria-labelledby="lead-title">
    <a class="ph-img" href={textHref(t)} tabindex="-1" aria-hidden="true">
      <Picture src={photo.src} alt="" widths={[640, 960, 1400, 2000]} sizes="100vw" formats={['avif', 'webp']} loading="eager" fetchpriority="high" />
    </a>
    <div class="wrap ph-text">
      <span class="lab"><b>{t.data.kind}</b>{longDate(t.data.date)}</span>
      <h1 id="lead-title"><a href={textHref(t)}>{t.data.title}</a></h1>
      {t.data.summary && <p>{t.data.summary}</p>}
      <div class="btn-row">
        <a class="btn btn-red" href={textHref(t)}>{t.data.photos.length > 1 ? 'Το κείμενο και οι φωτογραφίες' : 'Διάβασε το κείμενο'}</a>
        {t.data.video && <a class="btn btn-line" href={`${textHref(t)}#video`}>Δες το βίντεο</a>}
        {t.data.pdf && <a class="btn btn-line" href={u(t.data.pdf)} download>PDF</a>}
      </div>
    </div>
  </section>
) : t ? (
  <section class="lead-block" aria-labelledby="lead-title">
    <div class="wrap">
      <div class="lead-text">
        <span class="lab">{t.data.kind} · {longDate(t.data.date)}</span>
        <h1 id="lead-title"><a href={textHref(t)}>{t.data.title}</a></h1>
        {t.data.summary && <p>{t.data.summary}</p>}
        <div class="btn-row">
          <a class="btn btn-paper" href={textHref(t)}>Διάβασε το κείμενο</a>
          {t.data.pdf && <a class="btn btn-line" href={u(t.data.pdf)} download>PDF</a>}
        </div>
      </div>
    </div>
  </section>
) : (
  <section class="strike sse-hero" aria-labelledby="sse-title">
    <div class="wrap">
      <div class="strike-top">
        <p class="kicker">Κλαδική Συλλογική Σύμβαση</p>
        <p class="count">Από το 2012</p>
      </div>
      <h1 class="sse-mega" id="sse-title" aria-label={`${YEARS_WITHOUT_SSE} χρόνια χωρίς Σύμβαση`}>
        <span class="ln" aria-hidden="true" style="--i:0"><span>{YEARS_WITHOUT_SSE} ΧΡΟΝΙΑ</span></span>
        <span class="ln" aria-hidden="true" style="--i:1"><span>ΧΩΡΙΣ ΣΥΜΒΑΣΗ</span></span>
      </h1>
      <p class="date-line">ΘΑ ΤΗΝ ΕΠΙΒΑΛΟΥΜΕ ΟΡΓΑΝΩΜΕΝΟΙ</p>
      <div class="facts sse-facts">
        <div>
          <span class="lab">Πρώτος μισθός, καθαρά</span>
          <ul class="hero-wages">{WAGES.map((w) => <li><b>{w.amount}&nbsp;€</b><span>{w.short}</span></li>)}</ul>
          <p class="hero-step">και προσαύξηση κάθε δύο χρόνια</p>
        </div>
        <div><span class="lab">Χρόνος δουλειάς</span><p>7ωρο – 5ήμερο – 35ωρο</p><p class="hero-step">Πληρωμή κάθε ώρας υπερωρίας</p></div>
        <div><span class="lab">Για όλους</span><p>Και για όσους δουλεύουν με «μπλοκάκι»</p><p class="hero-step">Κατάργηση του ΔΠΥ</p></div>
      </div>
      <div class="btn-row">
        <a class="btn btn-paper" href={u('/melos/')}>Γίνε μέλος</a>
        <a class="btn btn-line" href={u('/sse/')}>Τι διεκδικούμε</a>
      </div>
    </div>
  </section>
)}
